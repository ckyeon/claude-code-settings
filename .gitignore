# OS junk
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Backup files produced by install.sh (these normally live in ~/.claude/,
# but list them here defensively in case they ever land inside the repo)
*.backup-*
*.bak

# Python bytecode (the tools set PYTHONDONTWRITEBYTECODE, this is a backstop)
__pycache__/

# direnv
.envrc
.direnv/

# Claude Code's claude.ai skill sync cache. ~/.claude/skills is a symlink to
# user/shared/skills, so the sync lands inside the repo.
user/shared/skills/synced/

# Codex project files generated at Codex install by copying this repo's
# Claude config (CLAUDE.md, check-updates skill, Stop hook). Machine-local.
AGENTS.md
.agents/
.codex/
