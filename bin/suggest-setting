#!/usr/bin/env python3
"""Record a suggestion for this settings repo in its inbox (ADR 0098).

A session in another project that finds something to change in the user
settings leaves it here, and a session in this repo processes it. Each
suggestion is one Markdown file under `inbox/`, so two sessions writing at once
never touch the same file. `inbox/` is gitignored: a suggestion may quote
another project, and this repo is public.

The skill `suggest-setting` reaches this script through a symlink in its
folder, so the repo is found from this file's resolved path, not from `$0`.
The project the suggestion comes from is the current directory.

`--list` shows what the inbox already holds, so a session can find a
suggestion on the same setting. More to say about it goes in a new file that
names the old one with `--follows`, never in the old file.
"""

from __future__ import annotations

import argparse
import itertools
import os
import re
import sys
import time
from pathlib import Path

INBOX = Path(__file__).resolve().parent.parent / "inbox"


def slug(title: str) -> str:
    return re.sub(r"\W+", "-", title.lower()).strip("-")[:40].rstrip("-") or "suggestion"


def list_inbox() -> int:
    for path in sorted(INBOX.glob("*.md")) if INBOX.is_dir() else []:
        lines = path.read_text(encoding="utf-8").splitlines()
        # The header is the title, a blank line, then "- key: value" lines up to the next blank.
        head = [l for l in itertools.takewhile(bool, lines[2:]) if l.startswith(("- 대상: ", "- 이어서: "))]
        print(path)
        for line in lines[:1] + head:
            print("  " + line)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="suggest-setting",
        description="Record a suggestion for this settings repo. The body is read from stdin.",
        epilog="Exit: 0 recorded or listed, 2 usage error.")
    ap.add_argument("--title", help="one line naming the change (required unless --list)")
    ap.add_argument("--target", action="append", default=[],
                    help="a setting the suggestion is about, relative to ~/.claude (repeatable)")
    ap.add_argument("--follows", metavar="FILE",
                    help="the file name of a suggestion in the inbox that this one continues")
    ap.add_argument("--list", action="store_true",
                    help="print each suggestion in the inbox, oldest first, with its title and targets")
    args = ap.parse_args()

    if args.list:
        if args.title is not None or args.target or args.follows:
            ap.error("--list takes no other option")
        return list_inbox()

    title = (args.title or "").strip()
    if not title or "\n" in title:
        ap.error("--title must be one non-empty line")
    follows = Path(args.follows).name if args.follows else None
    if follows and not (INBOX / follows).is_file():
        ap.error("no suggestion named %s in %s" % (follows, INBOX))
    body = sys.stdin.read().strip()
    if not body:
        ap.error("the body on stdin is empty")

    now = time.localtime()
    head = ["# " + title, "", "- 날짜: " + time.strftime("%Y-%m-%d %H:%M", now), "- 보낸 프로젝트: " + os.getcwd()]
    head += ["- 대상: " + t for t in args.target]
    if follows:
        head.append("- 이어서: " + follows)
    text = "\n".join(head) + "\n\n" + body + "\n"

    INBOX.mkdir(exist_ok=True)
    stem = time.strftime("%Y%m%d-%H%M%S", now) + "-" + slug(title)
    for n in itertools.count(1):
        path = INBOX / (stem + (".md" if n == 1 else "-%d.md" % n))
        try:
            with path.open("x", encoding="utf-8") as f:
                f.write(text)
        except FileExistsError:
            continue
        print(path)
        return 0


if __name__ == "__main__":
    sys.exit(main())
