#!/usr/bin/env bash
# Static integrity checks for repo-managed items. No network, no LLM, no side effects.
# Catches the class of defect where an adopted item outlives its dependencies.
#
# Usage: bin/check-integrity [--strict]
#   --strict   treat warnings as failures too
#
# Exit: 0 clean, 1 errors found (or warnings under --strict).

set -euo pipefail

STRICT=0
for arg in "$@"; do
  case "$arg" in
    --strict) STRICT=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "ERROR: unknown argument: $arg" >&2; exit 2 ;;
  esac
done

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

REPO_ROOT="$REPO_ROOT" STRICT="$STRICT" PYTHONDONTWRITEBYTECODE=1 python3 - <<'PYEOF'
import json
import os
import re
import sys

repo_root = os.environ["REPO_ROOT"]
strict = os.environ["STRICT"] == "1"
skills_dir = os.path.join(repo_root, "user", "shared", "skills")

sys.path.insert(0, os.path.join(repo_root, "lib"))
import declarations
import sidecars

errors = []   # (rel_path, line, message)
warnings = []

def rel(p):
    return os.path.relpath(p, repo_root)

# --- Inventory: which skill names can a reference resolve to? ---
# Repo-managed skills, plus skills vendored inside installed plugins (their
# cache lives outside this repo, so treat a hit there as "resolvable").
skill_names = set()
if os.path.isdir(skills_dir):
    skill_names = {
        d for d in os.listdir(skills_dir)
        if os.path.isfile(os.path.join(skills_dir, d, "SKILL.md"))
    }

plugin_cache = os.path.expanduser("~/.claude/plugins/cache")
if os.path.isdir(plugin_cache):
    for root, dirs, files in os.walk(plugin_cache):
        if "SKILL.md" in files:
            skill_names.add(os.path.basename(root))
            dirs[:] = []

# Bare `/token` refs that are not skill references. Filesystem roots and the
# Claude Code built-ins that skills legitimately name in prose.
NOT_A_SKILL = {
    "tmp", "usr", "etc", "var", "opt", "home", "bin", "lib", "dev", "proc",
    "goal", "plan", "settings", "workflows", "auto-approve", "config",
    "help", "clear", "compact", "review", "init", "agents", "docs", "cli",
}

# --- Frontmatter ---
def parse_frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n?", text, re.S)
    if not m:
        return None, text
    fields = {}
    for fm in re.finditer(r"^([a-zA-Z][\w-]*):[ \t]*(.*?)(?=\n[a-zA-Z][\w-]*:|\Z)",
                          m.group(1), re.S | re.M):
        fields[fm.group(1)] = fm.group(2).strip()
    return fields, text[m.end():]

# A reference is a skill reference when the noun "skill"/"skills" follows the
# backticked token(s). High precision: prose like `/tmp` never matches.
SKILL_REF = re.compile(
    r"((?:`/[a-z][a-z0-9-]*`(?:\s*(?:,|and)\s*)?)+)\s+skills?\b"
)
ANY_REF = re.compile(r"`/([a-z][a-z0-9-]*)`")
# Second phrasing in the wild (mattpocock/skills since d28dfdc): cross-skill
# calls written as `call the Skill tool with "name"` / `Call the Skill tool
# twice, for "a" and "b"` — quoted names near the phrase "Skill tool". The
# same repo also backticks the name (implement-spec, retro), so both count.
SKILL_TOOL_REF = re.compile(
    r"Skill tool\b[^\"`]{0,40}?((?:[\"`][a-z][a-z0-9-]*[\"`](?:\s*(?:,|and|or)\s*)*)+)"
)
QUOTED_NAME = re.compile(r"[\"`]([a-z][a-z0-9-]*)[\"`]")
# Documentation placeholders, not real skill names.
QUOTED_PLACEHOLDERS = {"name", "skill-name"}
MD_LINK = re.compile(r"\[([^\]]*)\]\(([^)]+)\)")
# Template placeholders, not links: `[<closed ticket title>](link)` in a
# skill that shows the user what a line should look like (wayfinder).
PLACEHOLDER_LINK_TARGETS = {"link", "url"}

def local_skills(d):
    if not os.path.isdir(d):
        return set()
    return {n for n in os.listdir(d) if os.path.isfile(os.path.join(d, n, "SKILL.md"))}

# Skill directories to check, each with the names its references may resolve
# to. A template's skills see their own template plus user scope, and
# user-scope skills never see a template's.
#
# Templates get the reference checks only (`full` is False). Their skills are
# copied from upstreams whose frontmatter names and links this repo does not
# control, and framework docs are full of `/route` tokens.
scopes = [(skills_dir, skill_names, True)]
templates_dir = os.path.join(repo_root, "project-templates")
if os.path.isdir(templates_dir):
    for t in sorted(os.listdir(templates_dir)):
        tdir = os.path.join(templates_dir, t, ".claude", "skills")
        if local_skills(tdir):
            scopes.append((tdir, skill_names | local_skills(tdir), False))

checked = []  # (scope_dir, count)
for scope_dir, resolvable, full in scopes:
    checked.append((scope_dir, len(local_skills(scope_dir))))
    for name in sorted(local_skills(scope_dir)):
        sdir = os.path.join(scope_dir, name)
        path = os.path.join(sdir, "SKILL.md")
        text = open(path, encoding="utf-8").read()
        fields, body = parse_frontmatter(text)
        r = rel(path)

        if full:
            if fields is None:
                errors.append((r, 1, "frontmatter block missing"))
                continue
            if fields.get("name") != name:
                errors.append((r, 1, f"frontmatter name {fields.get('name')!r} != directory {name!r}"))
            if not fields.get("description"):
                errors.append((r, 1, "description missing or empty"))

        for i, line in enumerate(body.splitlines(), start=1):
            referenced = set()
            for m in SKILL_REF.finditer(line):
                for ref in ANY_REF.finditer(m.group(1)):
                    referenced.add(ref.group(1))
                    if ref.group(1) not in resolvable:
                        errors.append((r, i, f"references skill `/{ref.group(1)}` — not installed"))
            for m in SKILL_TOOL_REF.finditer(line):
                for ref in QUOTED_NAME.finditer(m.group(1)):
                    tok = ref.group(1)
                    if tok in QUOTED_PLACEHOLDERS:
                        continue
                    referenced.add(tok)
                    if tok not in resolvable:
                        errors.append((r, i, f'references skill "{tok}" (Skill tool call) — not installed'))
            if not full:
                continue

            # Softer net: a backticked /token that is neither a known skill, a
            # built-in, nor a filesystem path. Recall for refs worded differently.
            for m in ANY_REF.finditer(line):
                tok = m.group(1)
                if tok in referenced or tok in resolvable or tok in NOT_A_SKILL:
                    continue
                warnings.append((r, i, f"unresolved reference `/{tok}` — skill? typo?"))

            for m in MD_LINK.finditer(line):
                text = m.group(1).strip()
                target = m.group(2).split("#")[0].strip()
                if not target or "://" in target or target.startswith("#"):
                    continue
                if (text.startswith("<") and text.endswith(">")) or \
                        (target.startswith("<") and target.endswith(">")) or \
                        target in PLACEHOLDER_LINK_TARGETS:
                    continue
                if not os.path.exists(os.path.join(sdir, target)):
                    errors.append((r, i, f"broken link: {target}"))

# --- Provenance sidecars ---
for sidecar, problem in sidecars.validate(repo_root):
    errors.append((sidecar, 1, problem))

# --- Declarations: every declared item carries the command that creates it ---
# A declared item is reproduced by running a command on the machine (ADR 0074),
# so a declaration without that command cannot be acted on. "plugin install"
# matches both the in-session `/plugin install` and the `claude plugin install`
# CLI form.
declared_plugins = declarations.declared(repo_root, "plugins")
declared_mcp = declarations.declared(repo_root, "mcp")
for kind, names, command in (("mcp", declared_mcp, "claude mcp add"),
                             ("plugins", declared_plugins, "plugin install")):
    for name in names:
        ddir = os.path.join(repo_root, "user", "shared", kind, name)
        readme = os.path.join(ddir, "README.md")
        if not os.path.isfile(readme):
            errors.append((rel(ddir), 1, f"declared without a README.md holding its `{command}` command"))
        elif command not in open(readme, encoding="utf-8").read():
            errors.append((rel(readme), 1, f"declaration lacks its `{command}` command"))

plugin_entries = declarations.plugin_entries(repo_root)  # name -> (marketplace, scope)
for name in declared_plugins:
    if not plugin_entries.get(name, ("", ""))[1]:
        warnings.append((rel(os.path.join(repo_root, "user", "shared", "plugins", name)), 1,
                         "declared plugin is not enabled in any settings.json"))
enabled_user = {name for name, (_market, scope) in plugin_entries.items() if scope == "user"}
for name in sorted(enabled_user - set(declared_plugins)):
    warnings.append(("user/shared/settings.json", 1,
                     f"plugin {name!r} is enabled but not declared under user/shared/plugins/"))

# --- Report ---
def emit(label, items):
    if not items:
        return
    print(f"\n{label} ({len(items)})")
    for path, line, msg in items:
        print(f"  {path}:{line}  {msg}")

for d, n in checked:
    print(f"Checked {n} skills in {rel(d)}")
print(f"Checked {len(declared_plugins)} plugin and {len(declared_mcp)} MCP server declarations")
emit("ERRORS", errors)
emit("WARNINGS", warnings)

if not errors and not warnings:
    print("\nClean.")
elif not errors:
    print(f"\n{len(warnings)} warning(s), no errors.")

sys.exit(1 if errors or (strict and warnings) else 0)
PYEOF
