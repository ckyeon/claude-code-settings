#!/usr/bin/env bash
# Check whether provenance-pinned upstream commits are behind HEAD (or behind
# the release or marketplace sha that a sidecar's top-level "track" names).
#
#   bin/check-updates          Fast check — git ls-remote, no clone except a
#                              shallow clone for marketplace-tracked items.
#   bin/check-updates --deep   Also clone outdated sources (blobless), check
#                              whether each tracked path actually changed, and
#                              list upstream entries added/removed next to the
#                              tracked paths (new/deleted skills), plus skills
#                              and plugins added anywhere else in the repo.
#                              Leaves clones + per-item logs/diffs in a temp
#                              workdir (printed at the end); caller is
#                              responsible for cleanup.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

DEEP=0
for arg in "$@"; do
  case "$arg" in
    --deep) DEEP=1 ;;
    -h|--help)
      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

REPO_ROOT="$REPO_ROOT" DEEP="$DEEP" PYTHONDONTWRITEBYTECODE=1 python3 - <<'PYEOF'
import json
import os
import sys
import tempfile

sys.path.insert(0, os.path.join(os.environ["REPO_ROOT"], "lib"))
import sidecars
import targets
import updates

repo_root = os.environ["REPO_ROOT"]
deep = os.environ.get("DEEP") == "1"

# The deciding happens in lib/updates.py. This script only renders its records.
items, unreadable = sidecars.read(repo_root)
for rel, reason in unreadable:
    print(f"WARN: skipping unreadable sidecar {rel}: {reason}", file=sys.stderr)

sources = sorted({pin["source"] for item in items for pin in item.current_pins()})
if not sources:
    print("No provenance entries found.")
    sys.exit(0)
print(f"Checking {len(sources)} source{'s' if len(sources) != 1 else ''}...\n")

pins = updates.check(items, targets.Targets(repo_root))

# --- Fast report: one line per (source, pin, target) ---
groups = {}
for pin in pins:
    key = (pin["source"], pin["commit"], pin["target"], pin["target_note"])
    groups.setdefault(key, []).append(pin)

counts = {"current": 0, "outdated": 0, "unreachable": 0}
for (source, pinned, target, note), group in sorted(groups.items(), key=lambda kv: kv[0][:2]):
    label = updates.label_of(source)
    short_pin = pinned[:8] if pinned else "?"
    suffix = f"  [{note}]" if note else ""
    state = group[0]["state"]
    counts[state] += 1
    if state == "unreachable":
        print(f"? {label:<45} {note or 'unreachable'}")
    elif state == "current":
        print(f"✓ {label:<45} up to date  ({short_pin}){suffix}")
    else:
        print(f"✗ {label:<45} {short_pin} → {target[:8]}{suffix}")
        if len(group) <= 5:
            print(f"    {', '.join(os.path.basename(p['local']) for p in group)}")
        else:
            common = os.path.commonpath([p["local"] for p in group])
            print(f"    {len(group)} items ({common}/*)")

print(f"\n{counts['current']} up to date, {counts['outdated']} outdated" +
      (f", {counts['unreachable']} unreachable" if counts["unreachable"] else ""))

exit_code = 2 if counts["unreachable"] else (1 if counts["outdated"] else 0)
outdated = [p for p in pins if p["state"] == "outdated"]
if not deep or not outdated:
    sys.exit(exit_code)

# --- Deep pass ---
workdir = tempfile.mkdtemp(prefix="check-updates-deep-")
n_clones = len({updates.clone_name(p["source"]) for p in outdated})
print(f"\nDeep check: cloning {n_clones} outdated source{'s' if n_clones != 1 else ''} (blobless)...")
result = updates.investigate(pins, items, workdir)
records, structure_records = result["items"], result["structure"]

print()
by_source = {}
for rec in records:
    by_source.setdefault(rec["source"], []).append(rec)
structure_by_source = {}
for rec in structure_records:
    structure_by_source.setdefault(rec["source"], []).append(rec)

for src in sorted(by_source):
    recs = by_source[src]
    print(f"{updates.label_of(src)}  → {', '.join(sorted({r['target'][:8] for r in recs}))}")
    for rec in recs:
        if rec["status"] == "changed":
            n = rec["commit_count"]
            print(f"  CHANGED  {n:>3} commit{'s' if n != 1 else ''}  {rec['local']}")
        elif rec["status"] == "error":
            print(f"  ERROR    {rec['local']}: {rec['error']}")
    pin_only = [r for r in recs if r["status"] == "pin-only"]
    if len(pin_only) > 5:
        common = os.path.commonpath([r["local"] for r in pin_only])
        print(f"  pin-only     {len(pin_only)} items ({common}/*)")
    else:
        for rec in pin_only:
            print(f"  pin-only     {rec['local']}")
    for srec in structure_by_source.get(src, []):
        mark = "  (outside tracked dirs)" if srec["scope"] == "elsewhere" else ""
        for p in srec["added"]:
            print(f"  NEW      upstream added   {p}{mark}")
        for p in srec["removed"]:
            mark_removed = "  ** adopted here **" if p in srec["removed_tracked"] else ""
            print(f"  REMOVED  upstream removed {p}{mark_removed}")

summary_path = os.path.join(workdir, "deep.json")
with open(summary_path, "w") as f:
    json.dump({"workdir": workdir, "items": records, "structure": structure_records}, f, indent=2)
    f.write("\n")

total = lambda status: sum(1 for r in records if r["status"] == status)
added_total = sum(len(r["added"]) for r in structure_records)
removed_total = sum(len(r["removed"]) for r in structure_records)
print(f"\n{total('changed')} changed, {total('pin-only')} pin-only" +
      (f", {added_total} upstream-new" if added_total else "") +
      (f", {removed_total} upstream-removed" if removed_total else "") +
      (f", {total('error')} errors" if total("error") else ""))
print(f"\nWorkdir kept for inspection (clones + per-item log.txt/upstream.diff):")
print(f"  {workdir}")
print(f"  {summary_path}")
print(f"Clean up with: rm -rf {workdir}")

sys.exit(2 if (counts["unreachable"] or total("error")) else 1)
PYEOF
